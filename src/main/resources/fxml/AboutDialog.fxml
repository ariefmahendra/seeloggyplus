<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.seeloggyplus.app.AboutDialogController"
            prefWidth="420" prefHeight="320" minWidth="360" minHeight="280" styleClass="about-dialog, simple-dialog">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="about-dialog-header">
            <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                <Image url="@../images/app-icon.png"/>
            </ImageView>
            <VBox spacing="4">
                <Label text="SeeLoggyPlus" styleClass="about-dialog-title"/>
                <Label fx:id="versionLabel" styleClass="about-version"/>
            </VBox>
        </HBox>
    </top>
    <center>
        <VBox spacing="12" styleClass="about-dialog-body">
            <TextFlow lineSpacing="3">
                <Text styleClass="about-description" text="A fast, lightweight log viewer built for developers and ops teams. Browse local log files, monitor remote servers in real-time over SSH, and quickly find what you need with powerful search and filtering."/>
            </TextFlow>
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="Contact:" styleClass="about-contact-label"/>
                <Hyperlink fx:id="contactLink" styleClass="about-contact" text="mahend.arief@gmail.com">
                    <tooltip><Tooltip text="Send feedback or questions to mahend.arief@gmail.com"/></tooltip>
                </Hyperlink>
            </HBox>
            <Label text="© 2025–2026 SeeLoggyPlus" styleClass="about-copyright"/>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" styleClass="simple-dialog-footer">
            <Button fx:id="closeButton" defaultButton="true" cancelButton="true" text="Close"/>
        </HBox>
    </bottom>
</BorderPane>
