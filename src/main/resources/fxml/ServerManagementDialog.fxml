<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.seeloggyplus.features.servers.presentation.ServerManagementDialogController" prefWidth="1000" prefHeight="640" styleClass="server-management-dialog, simple-dialog">
<top><HBox fx:id="serverToolbar" spacing="6" alignment="CENTER_LEFT" styleClass="server-toolbar">
<Button fx:id="addServerButton" text="Add Server"><graphic><FontAwesomeIconView glyphName="PLUS" size="12"/></graphic></Button>
<Separator orientation="VERTICAL"/>
<Button fx:id="editServerButton" accessibleText="Edit" styleClass="server-icon-button"><graphic><FontAwesomeIconView glyphName="EDIT" size="12"/></graphic><tooltip><Tooltip text="Edit"/></tooltip></Button><Button fx:id="cloneServerButton" accessibleText="Clone Server" styleClass="server-icon-button"><graphic><FontAwesomeIconView glyphName="CLONE" size="12"/></graphic><tooltip><Tooltip text="Clone Server"/></tooltip></Button><Button fx:id="moveToGroupButton" accessibleText="Move Server to Group" styleClass="server-icon-button"><graphic><FontAwesomeIconView glyphName="SIGN_IN" size="12"/></graphic><tooltip><Tooltip text="Move Server to Group"/></tooltip></Button><Button fx:id="deleteServerButton" accessibleText="Delete" styleClass="server-icon-button"><graphic><FontAwesomeIconView glyphName="TRASH" size="12"/></graphic><tooltip><Tooltip text="Delete"/></tooltip></Button><Region HBox.hgrow="ALWAYS"/><TextField fx:id="searchField" promptText="Filter servers..." prefWidth="220" minWidth="160" maxWidth="220"/>
<Button fx:id="clearSearchButton" accessibleText="Clear Filter" styleClass="server-icon-button"><graphic><FontAwesomeIconView glyphName="TIMES" size="12"/></graphic><tooltip><Tooltip text="Clear Filter"/></tooltip></Button><Button fx:id="refreshButton" accessibleText="Refresh" styleClass="server-icon-button"><graphic><FontAwesomeIconView glyphName="REFRESH" size="12"/></graphic><tooltip><Tooltip text="Refresh"/></tooltip></Button></HBox></top>
<center><SplitPane fx:id="serverSplitPane" dividerPositions="0.2">
<VBox fx:id="groupSidebar" minWidth="160" prefWidth="200" maxWidth="320" spacing="8" styleClass="server-group-sidebar"><padding><Insets top="12" right="10" bottom="10" left="10"/></padding>
<HBox alignment="CENTER_LEFT" spacing="4" styleClass="server-group-header"><Label text="Groups" styleClass="section-title" minWidth="0"/><Region HBox.hgrow="ALWAYS"/>
<Button fx:id="newGroupButton" accessibleText="New Group" styleClass="server-icon-button"><graphic><FontAwesomeIconView glyphName="PLUS_SQUARE" size="12"/></graphic><tooltip><Tooltip text="New Group"/></tooltip></Button><Button fx:id="renameGroupButton" accessibleText="Rename Group" styleClass="server-icon-button"><graphic><FontAwesomeIconView glyphName="EDIT" size="12"/></graphic><tooltip><Tooltip text="Rename Group"/></tooltip></Button><Button fx:id="deleteGroupButton" accessibleText="Delete Group" styleClass="server-icon-button"><graphic><FontAwesomeIconView glyphName="TRASH" size="12"/></graphic><tooltip><Tooltip text="Delete Group"/></tooltip></Button></HBox><TreeView fx:id="groupTree" VBox.vgrow="ALWAYS"/></VBox>
<TableView fx:id="serverTable" fixedCellSize="28" tableMenuButtonVisible="true"><columns>
<TableColumn fx:id="nameColumn" text="Name" prefWidth="160" minWidth="160"/>
<TableColumn fx:id="hostColumn" text="Host" prefWidth="220" minWidth="180"/>
<TableColumn fx:id="portColumn" text="Port" prefWidth="64" minWidth="48" maxWidth="64"/>
<TableColumn fx:id="usernameColumn" text="Username" prefWidth="110" minWidth="80"/>
<TableColumn fx:id="groupColumn" text="Group" prefWidth="150" visible="false"/>
<TableColumn fx:id="defaultPathColumn" text="Default Path" prefWidth="200" visible="false"/>
<TableColumn fx:id="lastUsedColumn" text="Last Used" prefWidth="150" visible="false"/>
</columns><placeholder><VBox alignment="CENTER" spacing="8"><FontAwesomeIconView glyphName="SERVER" size="32" styleClass="empty-state-icon"/><Label text="No SSH servers configured" styleClass="empty-state-title"/><Label text="Click 'Add Server' to create a new SSH server configuration" styleClass="empty-state-subtitle" wrapText="true"/></VBox></placeholder></TableView>
</SplitPane></center>
<bottom><VBox>
<VBox fx:id="detailsPanel" visible="false" managed="false" spacing="4" styleClass="server-details"><padding><Insets top="6" right="10" bottom="6" left="10"/></padding>
<HBox spacing="8"><Label text="Name:" styleClass="text-secondary"/><Label fx:id="detailNameLabel" text="-" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/><Label text="Connection:" styleClass="text-secondary"/><Label fx:id="detailConnectionLabel" text="-" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
<Label fx:id="detailHostLabel" text="-" visible="false" managed="false"/><Label fx:id="detailUsernameLabel" text="-" visible="false" managed="false"/><Label fx:id="detailPortLabel" text="-" visible="false" managed="false"/></HBox>
<HBox spacing="8"><Label text="Default Path:" styleClass="text-secondary"/><Label fx:id="detailPathLabel" text="-" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/></HBox>
<HBox spacing="8"><Label text="Created:" styleClass="text-secondary"/><Label fx:id="detailCreatedLabel" text="-"/><Region HBox.hgrow="ALWAYS"/><Label text="Last Used:" styleClass="text-secondary"/><Label fx:id="detailLastUsedLabel" text="-"/></HBox>
</VBox>
<HBox fx:id="serverFooter" spacing="8" alignment="CENTER_LEFT" styleClass="server-footer"><Label fx:id="serverCountLabel" text="0 servers"/><Label fx:id="selectionLabel" text="No selection" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/><ToggleButton fx:id="detailsButton" text="Details" disable="true"/><Button fx:id="closeButton" text="Close" cancelButton="true"/></HBox>
</VBox></bottom>
</BorderPane>
