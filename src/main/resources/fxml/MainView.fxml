<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<BorderPane minHeight="400" minWidth="600" prefHeight="800" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.seeloggyplus.controller.MainController">
    <top>
        <VBox>
            <MenuBar fx:id="menuBar">
                <!-- File Menu -->
                <Menu text="File">
                    <MenuItem accelerator="Ctrl+O" onAction="#handleOpen" text="Open..." />
                    <SeparatorMenuItem />
                    <MenuItem fx:id="exitMenuItem" accelerator="Alt+F4" text="Exit" />
                </Menu>

                <!-- View Menu -->
                <Menu fx:id="viewMenu" text="View">
                    <CheckMenuItem fx:id="showLeftPanelMenuItem" selected="true" text="Show Recent Files Panel" />
                    <CheckMenuItem fx:id="showBottomPanelMenuItem" selected="true" text="Show Detail Panel" />
                    <SeparatorMenuItem />
                    <MenuItem accelerator="F5" text="Refresh" />
                </Menu>

                <!-- Settings Menu -->
                <Menu text="Settings">
                    <MenuItem fx:id="parsingConfigMenuItem" accelerator="Ctrl+P" text="Parsing Configuration..." />
                    <MenuItem fx:id="serverManagementMenuItem" accelerator="Ctrl+M" text="Server Management..." />
                    <SeparatorMenuItem />
                    <MenuItem fx:id="preferencesMenuItem" text="Preferences..." />
                </Menu>

                <!-- Help Menu -->
                <Menu text="Help">
                    <MenuItem fx:id="aboutMenuItem" text="About" />
                </Menu>
            </MenuBar>

            <!-- Toolbar -->
            <ToolBar>
                <Label text="Search:" />
                <TextField fx:id="searchField" prefWidth="300" promptText="Enter search text or regex...">
                    <font>
                        <Font size="10.0" />
                    </font>
                </TextField>
                <ToggleButton fx:id="regexCheckBox" text="Regex" />
                <ToggleButton fx:id="caseSensitiveCheckBox" text="Case Sensitive" />
                <Separator orientation="VERTICAL" />
                <Label text="Level:" />
                <ComboBox fx:id="logLevelFilterComboBox" prefHeight="16.0" prefWidth="115.0" promptText="All Levels" styleClass="small-combo-box" stylesheets="@../style/components.css" />
                <Separator orientation="VERTICAL" />
                <Label text="From:" />
                <TextField fx:id="dateTimeFromField" prefWidth="150" promptText="yyyy-MM-dd HH:mm:ss">
                    <font>
                        <Font size="10.0" />
                    </font>
                    <tooltip>
                        <Tooltip text="Start date/time (yyyy-MM-dd HH:mm:ss)" />
                    </tooltip>
                </TextField>
                <Label text="To:" />
                <TextField fx:id="dateTimeToField" prefWidth="150" promptText="yyyy-MM-dd HH:mm:ss">
                    <font>
                        <Font size="10.0" />
                    </font>
                    <tooltip>
                        <Tooltip text="End date/time (yyyy-MM-dd HH:mm:ss)" />
                    </tooltip>
                </TextField>
                <Button fx:id="clearDateFilterButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="TIMES" size="12" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Clear Date Filter" />
                    </tooltip>
                </Button>
                <Separator orientation="VERTICAL" />
                <Button fx:id="searchButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="SEARCH" size="12" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Apply Filters" />
                    </tooltip>
                </Button>
                <Button fx:id="clearSearchButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="TIMES_CIRCLE" size="12" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Clear All Filters" />
                    </tooltip>
                </Button>
                <Separator orientation="VERTICAL" />
                <Button fx:id="autoFitButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="COLUMNS" size="12" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Auto Fit Table Columns" />
                    </tooltip>
                </Button>
                <Button fx:id="refreshButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="REFRESH" size="12" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Reload Log" />
                    </tooltip>
                </Button>
                <Button fx:id="scrollToTopButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="ARROW_UP" size="12" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Scroll to Top" />
                    </tooltip>
                </Button>

                <Button fx:id="scrollToBottomButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="ARROW_DOWN" size="12" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Scroll to Bottom" />
                    </tooltip>
                </Button>
                <ToggleButton fx:id="tailButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="EYE" size="12" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Tail (follow last entries)" />
                    </tooltip>
                </ToggleButton>
            </ToolBar>
        </VBox>
    </top>

    <!-- Center: Main Content -->
    <center>
        <StackPane>
            <BorderPane xmlns="http://javafx.com/javafx">
                <!-- Collapsed Left Panel (appears when leftPanel is unpinned) -->
                <left>
                    <VBox fx:id="collapsedLeftPanel" alignment="TOP_CENTER" managed="false" prefWidth="20" spacing="10" visible="false">
                        <padding>
                            <Insets bottom="5" left="5" right="5" top="5" />
                        </padding>

                        <Button fx:id="expandLeftPanelButton" rotate="90">
                            <graphic>
                                <FontAwesomeIconView glyphName="ANGLE_DOUBLE_RIGHT" size="12" />
                            </graphic>
                            <tooltip>
                                <Tooltip text="Expand Recent Files" />
                            </tooltip>
                        </Button>
                    </VBox>
                </left>

                <center>
                    <SplitPane fx:id="horizontalSplitPane" dividerPositions="0.2">
                        <!-- Left Panel: Recent Files -->
                        <VBox fx:id="leftPanel" minWidth="200" prefWidth="250" spacing="5">
                            <padding>
                                <Insets bottom="5" left="5" right="5" top="5" />
                            </padding>

                            <HBox spacing="5">
                                <Label prefHeight="18.0" prefWidth="294.0" text="Recent Log Files" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <Separator prefWidth="200.0" HBox.hgrow="ALWAYS" />
                                <Button fx:id="pinLeftPanelButton">
                                    <graphic>
                                        <FontAwesomeIconView glyphName="ANGLE_DOUBLE_LEFT" size="12" />
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Collapse Recent Files Panel" />
                                    </tooltip>
                                </Button>
                            </HBox>

                            <ListView fx:id="recentFilesListView" VBox.vgrow="ALWAYS" />

                            <Button fx:id="clearRecentButton" maxWidth="Infinity" text="Clear Recent Files">
                                <graphic>
                                    <FontAwesomeIconView glyphName="TIMES_CIRCLE" size="12" />
                                </graphic>
                            </Button>
                        </VBox>

                        <!-- Right Panel: Log Viewer and Detail -->
                        <BorderPane>
                            <!-- Collapsed Bottom Panel (appears when bottomPanel is unpinned) -->
                            <bottom>
                                <HBox fx:id="collapsedBottomPanel" alignment="CENTER_LEFT" managed="false" prefHeight="20" spacing="10" visible="false">
                                    <padding>
                                        <Insets bottom="5" left="5" right="5" top="5" />
                                    </padding>

                                    <Button fx:id="expandBottomPanelButton">
                                        <graphic>
                                            <FontAwesomeIconView glyphName="ANGLE_DOUBLE_LEFT" size="12" rotate="90" />
                                        </graphic>
                                        <tooltip>
                                            <Tooltip text="Expand Detail Panel" />
                                        </tooltip>
                                    </Button>
                                    <Label text="Log Detail (Collapsed)">
                                        <font>
                                            <Font name="System Bold" size="10.0" />
                                        </font>
                                    </Label>
                                </HBox>
                            </bottom>

                            <center>
                                <SplitPane fx:id="verticalSplitPane" dividerPositions="0.7" orientation="VERTICAL">
                                    <!-- Center Panel: Log Table -->
                                    <VBox spacing="5">
                                        <padding>
                                            <Insets bottom="5" left="5" right="5" top="5" />
                                        </padding>

                                        <TableView fx:id="logTableView" stylesheets="@../style/highlight.css" VBox.vgrow="ALWAYS">
                                            <placeholder>
                                                <Label text="No log file loaded. Open a file to view logs." />
                                            </placeholder>
                                        </TableView>
                                        
                                        <!-- Pagination Bar -->
                                        <HBox fx:id="paginationBar" alignment="CENTER" spacing="5" styleClass="pagination-bar">
                                            <padding>
                                                <Insets bottom="5" left="10" right="10" top="5" />
                                            </padding>
                                            <Button fx:id="firstPageButton" text="«" minWidth="32">
                                                <tooltip>
                                                    <Tooltip text="First Page" />
                                                </tooltip>
                                            </Button>
                                            <Button fx:id="prevPageButton" text="‹" minWidth="32">
                                                <tooltip>
                                                    <Tooltip text="Previous Page" />
                                                </tooltip>
                                            </Button>
                                            <HBox fx:id="pageButtonsContainer" alignment="CENTER" spacing="3" />
                                            <Button fx:id="nextPageButton" text="›" minWidth="32">
                                                <tooltip>
                                                    <Tooltip text="Next Page" />
                                                </tooltip>
                                            </Button>
                                            <Button fx:id="lastPageButton" text="»" minWidth="32">
                                                <tooltip>
                                                    <Tooltip text="Last Page" />
                                                </tooltip>
                                            </Button>
                                            <Separator orientation="VERTICAL" />
                                            <Label fx:id="pageInfoLabel" text="Page 1 of 1" />
                                            <Separator orientation="VERTICAL" />
                                            <Label text="Per page:" />
                                            <ComboBox fx:id="pageSizeComboBox" prefWidth="90">
                                                <tooltip>
                                                    <Tooltip text="Items per page" />
                                                </tooltip>
                                            </ComboBox>
                                        </HBox>
                                    </VBox>

                                    <!-- Bottom Panel: Log Detail -->
                                    <VBox fx:id="bottomPanel" minHeight="150" prefHeight="200" spacing="5">
                                        <padding>
                                            <Insets bottom="5" left="5" right="5" top="5" />
                                        </padding>

                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <Label fx:id="detailLabel" text="Log Detail" HBox.hgrow="ALWAYS">
                                                <font>
                                                    <Font name="System Bold" size="12.0" />
                                                </font>
                                            </Label>

                                            <HBox alignment="CENTER_LEFT" spacing="5">
                                                <ToggleButton fx:id="prettifyJsonButton" prefHeight="10.0" prefWidth="10.0">
                                                    <graphic>
                                                        <FontAwesomeIconView glyphName="INDENT" size="12" />
                                                    </graphic>
                                                    <tooltip>
                                                        <Tooltip text="Auto-Prettify JSON" />
                                                    </tooltip>
                                                </ToggleButton>
                                                <ToggleButton fx:id="prettifyXmlButton" prefHeight="10.0" prefWidth="10.0">
                                                    <graphic>
                                                        <FontAwesomeIconView glyphName="CODE" size="12" />
                                                    </graphic>
                                                    <tooltip>
                                                        <Tooltip text="Auto-Prettify XML" />
                                                    </tooltip>
                                                </ToggleButton>
                                                <Button fx:id="copyButton">
                                                    <graphic>
                                                        <FontAwesomeIconView glyphName="COPY" size="12" />
                                                    </graphic>
                                                    <tooltip>
                                                        <Tooltip text="Copy" />
                                                    </tooltip>
                                                </Button>
                                                <Button fx:id="clearDetailButton">
                                                    <graphic>
                                                        <FontAwesomeIconView glyphName="CLOSE" size="12" />
                                                    </graphic>
                                                    <tooltip>
                                                        <Tooltip text="Clear" />
                                                    </tooltip>
                                                </Button>
                                                <Separator orientation="VERTICAL" />
                                                <Button fx:id="pinBottomPanelButton">
                                                    <graphic>
                                                        <FontAwesomeIconView glyphName="ANGLE_DOUBLE_DOWN" size="12" />
                                                    </graphic>
                                                    <tooltip>
                                                        <Tooltip text="Pin/Unpin Detail Panel" />
                                                    </tooltip>
                                                </Button>
                                            </HBox>
                                        </HBox>
                                    </VBox>
                                </SplitPane>
                            </center>
                        </BorderPane>
                    </SplitPane>
                </center>
            </BorderPane>
            
            <!-- Loading Overlay -->
            <VBox fx:id="loadingOverlay" alignment="CENTER" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.4);">
                <VBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 0); -fx-min-width: 300; -fx-max-width: 400;">
                    <ProgressIndicator fx:id="loadingProgress" minWidth="60" minHeight="60" maxWidth="60" maxHeight="60" />
                    <Label text="Processing Request..." textFill="#333333">
                        <font>
                            <Font name="System Bold" size="18.0" />
                        </font>
                    </Label>
                    <Label fx:id="loadingLabel" text="Please wait..." textFill="#666666" wrapText="true" textAlignment="CENTER">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                    <Button fx:id="cancelProcessingButton" text="Cancel" onAction="#handleCancelProcessing" style="-fx-base: #ffdddd; -fx-text-fill: #cc0000; -fx-border-color: #cc0000; -fx-border-radius: 3; -fx-background-radius: 3;">
                        <tooltip>
                            <Tooltip text="Stop current operation" />
                        </tooltip>
                    </Button>
                </VBox>
            </VBox>
        </StackPane>
    </center>



</BorderPane>
