<?xml version="1.0" encoding="UTF-8"?>

<?import com.seeloggyplus.features.search.presentation.SearchNavigator?>
<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>
<?import java.net.URL?>
<BorderPane styleClass="main-view" minHeight="400" minWidth="600" prefHeight="700" prefWidth="1024.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.seeloggyplus.app.MainController">
    <stylesheets>
        <URL value="@../style/theme.css"/>
        <URL value="@../style/components.css"/>
    </stylesheets>
    <top>
        <VBox>
            <MenuBar fx:id="menuBar" styleClass="app-menubar">
                <Menu text="_File">
                    <MenuItem accelerator="Ctrl+O" onAction="#handleOpen" text="Open..."/>
                    <MenuItem fx:id="closeTabMenuItem" accelerator="Ctrl+W" onAction="#handleCloseCurrentTab"
                              text="Close Tab"/>
                    <MenuItem fx:id="closeAllTabsMenuItem" onAction="#handleCloseAllTabs" text="Close All Tabs"/>
                    <MenuItem fx:id="clearLogMenuItem" text="Clear Log View" onAction="#handleClearLog"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="exitMenuItem" accelerator="Alt+F4" text="Exit"/>
                </Menu>

                <Menu text="_View">
                    <CheckMenuItem fx:id="showLeftPanelMenuItem" selected="true" text="Show Recent Files Panel"/>
                    <CheckMenuItem fx:id="showBottomPanelMenuItem" selected="true" text="Show Detail Panel"/>
                    <SeparatorMenuItem/>
                    <MenuItem accelerator="Ctrl+G" onAction="#handleGoToLine" text="Go To Line..."/>
                    <MenuItem fx:id="refreshMenuItem" accelerator="F5" onAction="#handleReload" text="Refresh"/>
                    <SeparatorMenuItem/>
                    <Menu text="Results Position">
                        <RadioMenuItem fx:id="resultsAutoMenuItem" text="Auto" selected="true"/>
                        <RadioMenuItem fx:id="resultsRightMenuItem" text="Right"/>
                        <RadioMenuItem fx:id="resultsBottomMenuItem" text="Bottom"/>
                    </Menu>
                    <MenuItem text="Reset Layout" onAction="#resetWorkbenchLayout"/>
                </Menu>

                <Menu text="_Settings">
                    <MenuItem fx:id="serverManagementMenuItem" accelerator="Ctrl+M" text="Server Management..."/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="preferencesMenuItem" text="Preferences..."/>
                </Menu>

                <Menu text="_Diagnostics">
                    <MenuItem text="Run Garbage Collection" onAction="#handleGC"/>
                </Menu>
                <Menu text="_Help">
                    <MenuItem fx:id="helpContentsMenuItem" text="Help Contents" accelerator="F1"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="storeMenuItem" text="Open Microsoft Store" onAction="#handleOpenMicrosoftStore" visible="false"/>
                    <MenuItem fx:id="aboutMenuItem" text="About"/>
                </Menu>
            </MenuBar>

            <ToolBar fx:id="workbenchToolbar" styleClass="app-toolbar,workbench-toolbar">
                <Button fx:id="openFileButton" text="Open" onAction="#handleOpen" accessibleText="Open log file">
                    <graphic><FontAwesomeIconView glyphName="FOLDER_OPEN" size="16"/></graphic>
                    <tooltip><Tooltip text="Open log file (Ctrl+O)"/></tooltip>
                </Button>
                <Button fx:id="serversButton" text="Servers" onAction="#handleServerManagement">
                    <graphic><FontAwesomeIconView glyphName="SERVER" size="16"/></graphic>
                    <tooltip><Tooltip text="Manage SSH servers (Ctrl+M)"/></tooltip>
                </Button>
                <Separator orientation="VERTICAL"/>
                <TextField fx:id="searchField" minWidth="140" prefWidth="260" promptText="Search logs..."/>
                <ToggleButton fx:id="regexCheckBox" text=".*" accessibleText="Regular expression"><tooltip><Tooltip text="Use regular expressions"/></tooltip></ToggleButton>
                <ToggleButton fx:id="caseSensitiveCheckBox" text="Aa" accessibleText="Case sensitive"><tooltip><Tooltip text="Match case"/></tooltip></ToggleButton>
                <Button fx:id="searchButton" accessibleText="Search logs">
                    <graphic><FontAwesomeIconView glyphName="SEARCH" size="16"/></graphic>
                    <tooltip><Tooltip text="Search logs (Enter)"/></tooltip>
                </Button>
                <Button fx:id="clearSearchButton" accessibleText="Clear search">
                    <graphic><FontAwesomeIconView glyphName="TIMES_CIRCLE" size="16"/></graphic>
                    <tooltip><Tooltip text="Clear search"/></tooltip>
                </Button>
                <SearchNavigator fx:id="searchNavigator"/>
                <Separator orientation="VERTICAL"/>
                <ToggleButton fx:id="tailButton" text="Tail">
                    <graphic><FontAwesomeIconView glyphName="TERMINAL" size="16"/></graphic>
                    <tooltip><Tooltip text="Enable or pause Tail"/></tooltip>
                </ToggleButton>
                <Label fx:id="tailStatusLabel" text="Paused" styleClass="tail-status"/>
                <ToggleButton fx:id="followTailButton" text="Follow" selected="true">
                    <graphic><FontAwesomeIconView glyphName="ARROW_DOWN" size="16"/></graphic>
                    <tooltip><Tooltip text="Follow new lines; disabling Follow keeps Tail running"/></tooltip>
                </ToggleButton>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="centerRoot">
            <SplitPane fx:id="horizontalSplitPane" dividerPositions="0.2">
                <fx:include fx:id="recentPanel" source="RecentFilesPanel.fxml"/>
                <SplitPane fx:id="verticalSplitPane" dividerPositions="0.7" orientation="VERTICAL">
                    <VBox fx:id="logIsland" minHeight="120" minWidth="0">
                        <StackPane fx:id="logContainer" VBox.vgrow="ALWAYS">
                            <VBox fx:id="emptyStatePane" alignment="CENTER" styleClass="empty-state-pane">
                                <VBox alignment="CENTER" spacing="8" fillWidth="false" minWidth="0" maxWidth="320" styleClass="empty-state-content">
                                    <StackPane minWidth="44" prefWidth="44" maxWidth="44" minHeight="44" prefHeight="44" maxHeight="44">
                                        <FontAwesomeIconView glyphName="FILE_TEXT_ALT" size="28" styleClass="empty-state-icon"/>
                                    </StackPane>
                                    <Label text="No Log File Open" alignment="CENTER" styleClass="empty-state-title"/>
                                    <Label text="Drop a log file here or open one with Ctrl+O." wrapText="true" alignment="CENTER" textAlignment="CENTER" maxWidth="280" minWidth="0" styleClass="empty-state-subtitle"/>
                                    <Button text="Open File..." onAction="#handleOpen" minWidth="120" minHeight="28" prefHeight="28" maxHeight="28" graphicTextGap="6" styleClass="empty-state-button">
                                        <graphic>
                                            <FontAwesomeIconView glyphName="FOLDER_OPEN" size="12"/>
                                        </graphic>
                                        <VBox.margin>
                                            <Insets top="4"/>
                                        </VBox.margin>
                                    </Button>
                                </VBox>
                            </VBox>
                            <TabPane fx:id="logTabPane" styleClass="log-tab-pane" tabClosingPolicy="ALL_TABS"
                                     tabDragPolicy="REORDER" visible="false" managed="false"/>
                        </StackPane>
                    </VBox>

                    <fx:include fx:id="detailPane" source="LogDetailPane.fxml"/>
                </SplitPane>
            </SplitPane>
            <VBox fx:id="loadingOverlay" alignment="CENTER" visible="false" styleClass="loading-overlay">
                <VBox alignment="CENTER" spacing="10" styleClass="loading-card">
                    <ProgressIndicator fx:id="loadingProgress" minWidth="32" minHeight="32" maxWidth="32"
                                       maxHeight="32"/>
                    <Label text="Processing Request..." styleClass="loading-title"/>
                    <Label fx:id="loadingLabel" text="Please wait..." wrapText="true" textAlignment="CENTER"
                           styleClass="loading-subtitle"/>
                    <Button text="Cancel" onAction="#handleCancelProcessing" styleClass="btn-danger-outline">
                        <tooltip>
                            <Tooltip text="Stop current operation"/>
                        </tooltip>
                    </Button>
                </VBox>
            </VBox>
            <clip>
                <Rectangle fx:id="centerClip"/>
            </clip>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="6" styleClass="status-bar">
                <ToggleButton fx:id="toggleLeftPanelButton" selected="true" styleClass="panel-toggle" accessibleText="Toggle Recent Files Panel">
                    <graphic><SVGPath content="M 2 2 H 16 V 14 H 2 Z M 7 2 V 14" styleClass="panel-layout-icon"/></graphic>
                    <tooltip><Tooltip text="Show/Hide Recent Files Panel (Ctrl+B)"/></tooltip>
                </ToggleButton>
                <ToggleButton fx:id="toggleBottomPanelButton" selected="true" styleClass="panel-toggle" accessibleText="Toggle Detail Panel">
                    <graphic><SVGPath content="M 2 2 H 16 V 14 H 2 Z M 2 10 H 16" styleClass="panel-layout-icon"/></graphic>
                    <tooltip><Tooltip text="Show/Hide Detail Panel (Ctrl+J)"/></tooltip>
                </ToggleButton>
            <Separator orientation="VERTICAL"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" minWidth="0" text="Line: 0 / 0 (0%)" styleClass="status-text"/>
            <Label fx:id="selectionStatusLabel" minWidth="0" maxWidth="200" styleClass="status-text-muted" visible="false" managed="false"/>
            <Separator orientation="VERTICAL"/>
            <MenuButton fx:id="resourceButton" text="Resources" minWidth="-Infinity" styleClass="resource-button">
                <items>
                    <CustomMenuItem hideOnClick="false">
                        <content><Label fx:id="resourceDetailLabel" text="Java heap usage" wrapText="true" maxWidth="300"/></content>
                    </CustomMenuItem>
                </items>
            </MenuButton>
            <Label fx:id="memoryStatusLabel" text="Heap: ..." styleClass="status-text-muted"/>
            <ProgressBar fx:id="memoryBar" prefWidth="50" progress="0.0" styleClass="status-memory-bar">
                <tooltip>
                    <Tooltip text="Heap Usage"/>
                </tooltip>
            </ProgressBar>
        </HBox>
    </bottom>

</BorderPane>
