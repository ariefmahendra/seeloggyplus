<?xml version="1.0" encoding="UTF-8"?>

<?import com.seeloggyplus.features.search.presentation.SearchNavigator?>
<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import java.net.URL?>
<BorderPane styleClass="main-view" minHeight="400" minWidth="600" prefHeight="700" prefWidth="1024.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.seeloggyplus.app.MainController">
    <stylesheets>
        <URL value="@../style/theme.css"/>
        <URL value="@../style/components.css"/>
    </stylesheets>
    <top>
        <VBox>
            <MenuBar fx:id="menuBar" styleClass="app-menubar">
                <Menu text="_File">
                    <MenuItem accelerator="Ctrl+O" onAction="#handleOpen" text="Open..."/>
                    <MenuItem fx:id="closeTabMenuItem" accelerator="Ctrl+W" onAction="#handleCloseCurrentTab"
                              text="Close Tab"/>
                    <MenuItem fx:id="closeAllTabsMenuItem" onAction="#handleCloseAllTabs" text="Close All Tabs"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="exitMenuItem" accelerator="Alt+F4" text="Exit"/>
                </Menu>

                <Menu text="_View">
                    <CheckMenuItem fx:id="showLeftPanelMenuItem" selected="true" text="Show Recent Files Panel"/>
                    <CheckMenuItem fx:id="showBottomPanelMenuItem" selected="true" text="Show Detail Panel"/>
                    <SeparatorMenuItem/>
                    <MenuItem accelerator="Ctrl+G" onAction="#handleGoToLine" text="Go To Line..."/>
                    <MenuItem fx:id="refreshMenuItem" accelerator="F5" onAction="#handleReload" text="Refresh"/>
                </Menu>

                <Menu text="_Settings">
                    <MenuItem fx:id="serverManagementMenuItem" accelerator="Ctrl+M" text="Server Management..."/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="preferencesMenuItem" text="Preferences..."/>
                </Menu>

                <Menu text="_Help">
                    <MenuItem fx:id="helpContentsMenuItem" text="Help Contents" accelerator="F1"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Check for Updates..." onAction="#handleCheckForUpdates"/>
                    <CheckMenuItem fx:id="autoCheckUpdatesMenuItem" text="Check for Updates Automatically"/>
                    <CheckMenuItem fx:id="autoDownloadUpdatesMenuItem" text="Download Updates Automatically"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="aboutMenuItem" text="About"/>
                </Menu>
            </MenuBar>

            <ToolBar styleClass="app-toolbar">
                <ToggleButton fx:id="toggleLeftPanelButton" selected="true">
                    <graphic>
                        <FontAwesomeIconView glyphName="FOLDER_OPEN" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Show/Hide Recent Files Panel (Ctrl+B)"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="toggleBottomPanelButton" selected="true">
                    <graphic>
                        <FontAwesomeIconView glyphName="FILE_TEXT" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Show/Hide Detail Panel (Ctrl+J)"/>
                    </tooltip>
                </ToggleButton>
                <Separator orientation="VERTICAL"/>
                <TextField fx:id="searchField" minWidth="120" prefWidth="200" promptText="Search logs..."/>

                <ToggleButton fx:id="regexCheckBox" text=".*" accessibleText="Regular expression"><tooltip><Tooltip text="Use regular expressions"/></tooltip></ToggleButton>
                <ToggleButton fx:id="caseSensitiveCheckBox" text="Aa" accessibleText="Case sensitive"><tooltip><Tooltip text="Match case"/></tooltip></ToggleButton>
                <Button fx:id="searchButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="SEARCH" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Apply Filters"/>
                    </tooltip>
                </Button>
                <Button fx:id="clearSearchButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="TIMES_CIRCLE" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Clear All Filters"/>
                    </tooltip>
                </Button>
                <SearchNavigator fx:id="searchNavigator"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="refreshButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="REFRESH" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Reload Log"/>
                    </tooltip>
                </Button>
                <ToggleButton fx:id="tailButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="TERMINAL" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Tail (Enable Tail Mode)"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="followTailButton" selected="true">
                    <graphic>
                        <FontAwesomeIconView glyphName="ARROW_DOWN" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Smart Follow (Auto-scroll to bottom)"/>
                    </tooltip>
                </ToggleButton>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="clearLogButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="TRASH" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Clear Log View"/>
                    </tooltip>
                </Button>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="centerRoot">
            <SplitPane fx:id="horizontalSplitPane" dividerPositions="0.2">
                <fx:include fx:id="recentPanel" source="RecentFilesPanel.fxml"/>
                <SplitPane fx:id="verticalSplitPane" dividerPositions="0.7" orientation="VERTICAL">
                    <VBox fx:id="logIsland" minHeight="120" minWidth="0">
                        <StackPane fx:id="logContainer" VBox.vgrow="ALWAYS">
                            <VBox fx:id="emptyStatePane" alignment="CENTER" styleClass="empty-state-pane">
                                <VBox alignment="CENTER" spacing="8" fillWidth="false" minWidth="0" maxWidth="320" styleClass="empty-state-content">
                                    <StackPane minWidth="44" prefWidth="44" maxWidth="44" minHeight="44" prefHeight="44" maxHeight="44">
                                        <FontAwesomeIconView glyphName="FILE_TEXT_ALT" size="28" styleClass="empty-state-icon"/>
                                    </StackPane>
                                    <Label text="No Log File Open" alignment="CENTER" styleClass="empty-state-title"/>
                                    <Label text="Drop a log file here or open one with Ctrl+O." wrapText="true" alignment="CENTER" textAlignment="CENTER" maxWidth="280" minWidth="0" styleClass="empty-state-subtitle"/>
                                    <Button text="Open File..." onAction="#handleOpen" minWidth="120" minHeight="28" prefHeight="28" maxHeight="28" graphicTextGap="6" styleClass="empty-state-button">
                                        <graphic>
                                            <FontAwesomeIconView glyphName="FOLDER_OPEN" size="12"/>
                                        </graphic>
                                        <VBox.margin>
                                            <Insets top="4"/>
                                        </VBox.margin>
                                    </Button>
                                </VBox>
                            </VBox>
                            <TabPane fx:id="logTabPane" styleClass="log-tab-pane" tabClosingPolicy="ALL_TABS"
                                     tabDragPolicy="REORDER" visible="false" managed="false"/>
                        </StackPane>
                    </VBox>

                    <fx:include fx:id="detailPane" source="LogDetailPane.fxml"/>
                </SplitPane>
            </SplitPane>
            <VBox fx:id="loadingOverlay" alignment="CENTER" visible="false" styleClass="loading-overlay">
                <VBox alignment="CENTER" spacing="10" styleClass="loading-card">
                    <ProgressIndicator fx:id="loadingProgress" minWidth="32" minHeight="32" maxWidth="32"
                                       maxHeight="32"/>
                    <Label text="Processing Request..." styleClass="loading-title"/>
                    <Label fx:id="loadingLabel" text="Please wait..." wrapText="true" textAlignment="CENTER"
                           styleClass="loading-subtitle"/>
                    <Button text="Cancel" onAction="#handleCancelProcessing" styleClass="btn-danger-outline">
                        <tooltip>
                            <Tooltip text="Stop current operation"/>
                        </tooltip>
                    </Button>
                </VBox>
            </VBox>
            <clip>
                <Rectangle fx:id="centerClip"/>
            </clip>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="6" styleClass="status-bar">
            <Label fx:id="statusLabel" text="Line: 0 / 0 (0%)" styleClass="status-text"/>
            <Label fx:id="selectionStatusLabel" styleClass="status-text-muted" visible="false" managed="false"/>
            <Separator orientation="VERTICAL"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="updateStatusLabel" styleClass="status-link" visible="false" managed="false">
                <tooltip>
                    <Tooltip text="A new version is available - click to update"/>
                </tooltip>
            </Label>
            <Button text="GC" onAction="#handleGC" styleClass="btn-compact">
                <tooltip>
                    <Tooltip text="Run Garbage Collection"/>
                </tooltip>
            </Button>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="memoryStatusLabel" text="Memory: ..." styleClass="status-text-muted"/>
            <ProgressBar fx:id="memoryBar" prefWidth="50" progress="0.0" styleClass="status-memory-bar">
                <tooltip>
                    <Tooltip text="Heap Usage"/>
                </tooltip>
            </ProgressBar>
        </HBox>
    </bottom>

</BorderPane>
