<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.Rectangle?>
<BorderPane minHeight="400" minWidth="600" prefHeight="800" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.seeloggyplus.controller.MainController">
    <top>
        <!-- Keep the top area always above the center content -->
        <VBox pickOnBounds="true" mouseTransparent="false">
            <MenuBar fx:id="menuBar">
                <!-- File Menu -->
                <Menu text="File">
                    <MenuItem accelerator="Ctrl+O" onAction="#handleOpen" text="Open..." />
                    <SeparatorMenuItem />
                    <MenuItem fx:id="exitMenuItem" accelerator="Alt+F4" text="Exit" />
                </Menu>

                <!-- View Menu -->
                <Menu text="View">
                    <CheckMenuItem fx:id="showLeftPanelMenuItem" selected="true" text="Show Recent Files Panel" />
                    <CheckMenuItem fx:id="showBottomPanelMenuItem" selected="true" text="Show Detail Panel" />
                    <SeparatorMenuItem />
                    <MenuItem accelerator="Ctrl+G" onAction="#handleGoToLine" text="Go To Line..." />
                    <MenuItem accelerator="F5" text="Refresh" />
                </Menu>

                <!-- Settings Menu -->
                <Menu text="Settings">
                    <MenuItem fx:id="serverManagementMenuItem" accelerator="Ctrl+M" text="Server Management..." />
                    <SeparatorMenuItem />
                    <MenuItem fx:id="preferencesMenuItem" text="Preferences..." />
                </Menu>

                <!-- Help Menu -->
                <Menu text="Help">
                    <MenuItem fx:id="aboutMenuItem" text="About" />
                </Menu>
            </MenuBar>

            <!-- Toolbar -->
            <ToolBar>
                <ToggleButton fx:id="toggleLeftPanelButton" selected="true">
                    <graphic>
                        <FontAwesomeIconView glyphName="FOLDER_OPEN" size="12" />
                    </graphic>
                     <tooltip>
                        <Tooltip text="Show/Hide Recent Files Panel (Ctrl+B)" />
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="toggleBottomPanelButton" selected="true">
                    <graphic>
                        <FontAwesomeIconView glyphName="FILE_TEXT" size="12" />
                    </graphic>
                     <tooltip>
                        <Tooltip text="Show/Hide Detail Panel (Ctrl+J)" />
                    </tooltip>
                </ToggleButton>
                <Separator orientation="VERTICAL" />
                <Label text="Search:" />
                <TextField fx:id="searchField" prefWidth="250" promptText="Include (Search)...">
                    <font>
                        <Font size="10.0" />
                    </font>
                </TextField>

                <ToggleButton fx:id="regexCheckBox" text="Regex" />
                <ToggleButton fx:id="caseSensitiveCheckBox" text="Case Sensitive" />
                <Button fx:id="searchButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="SEARCH" size="12" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Apply Filters" />
                    </tooltip>
                </Button>
                <Button fx:id="clearSearchButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="TIMES_CIRCLE" size="12" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Clear All Filters" />
                    </tooltip>
                </Button>
                <Separator orientation="VERTICAL" />
                <Button fx:id="refreshButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="REFRESH" size="12" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Reload Log" />
                    </tooltip>
                </Button>
                <ToggleButton fx:id="tailButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="EYE" size="12" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Tail (Enable Tail Mode)" />
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="followTailButton" selected="true">
                    <graphic>
                        <FontAwesomeIconView glyphName="ARROW_DOWN" size="12" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Smart Follow (Auto-scroll to bottom)" />
                    </tooltip>
                </ToggleButton>
                <Separator orientation="VERTICAL" />
                <Button fx:id="clearLogButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="TRASH" size="12" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Clear Log View" />
                    </tooltip>
                </Button>
            </ToolBar>
        </VBox>
    </top>

    <!-- Center: Main Content -->
    <center>
        <!-- Clip center so children cannot paint outside this region -->
        <StackPane fx:id="centerRoot" pickOnBounds="true">
            <BorderPane xmlns="http://javafx.com/javafx">
                <!-- Collapsed Left Panel (appears when leftPanel is unpinned) -->
                <left>
                    <VBox fx:id="collapsedLeftPanel" alignment="TOP_CENTER" managed="false" prefWidth="20" spacing="10" visible="false">
                        <padding>
                            <Insets bottom="5" left="5" right="5" top="5" />
                        </padding>

                        <Button fx:id="expandLeftPanelButton" rotate="90">
                            <graphic>
                                <FontAwesomeIconView glyphName="ANGLE_DOUBLE_RIGHT" size="12" />
                            </graphic>
                            <tooltip>
                                <Tooltip text="Expand Recent Files" />
                            </tooltip>
                        </Button>
                    </VBox>
                </left>

                <center>
                    <SplitPane fx:id="horizontalSplitPane" dividerPositions="0.2">
                        <!-- Left Panel: Recent Files -->
                        <VBox fx:id="leftPanel" minWidth="200" prefWidth="250" spacing="5">
                            <padding>
                                <Insets bottom="5" left="5" right="5" top="5" />
                            </padding>

                            <HBox spacing="5">
                                <Label prefHeight="18.0" prefWidth="294.0" text="Recent Log Files" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <Separator prefWidth="200.0" HBox.hgrow="ALWAYS" />
                                <Button fx:id="pinLeftPanelButton">
                                    <graphic>
                                        <FontAwesomeIconView glyphName="ANGLE_DOUBLE_LEFT" size="12" />
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Collapse Recent Files Panel" />
                                    </tooltip>
                                </Button>
                            </HBox>

                            <ListView fx:id="recentFilesListView" VBox.vgrow="ALWAYS" />

                            <Button fx:id="clearRecentButton" maxWidth="Infinity" text="Clear Recent Files">
                                <graphic>
                                    <FontAwesomeIconView glyphName="TIMES_CIRCLE" size="12" />
                                </graphic>
                            </Button>
                        </VBox>

                        <!-- Right Panel: Log Viewer and Detail -->
                        <BorderPane>
                            <!-- Collapsed Bottom Panel (appears when bottomPanel is unpinned) -->
                            <bottom>
                                <HBox fx:id="collapsedBottomPanel" alignment="CENTER_LEFT" prefHeight="20" spacing="10" visible="false">
                                    <padding>
                                        <Insets bottom="5" left="5" right="5" top="5" />
                                    </padding>

                                    <Button fx:id="expandBottomPanelButton">
                                        <graphic>
                                            <FontAwesomeIconView glyphName="ANGLE_DOUBLE_LEFT" size="12" rotate="90" />
                                        </graphic>
                                        <tooltip>
                                            <Tooltip text="Expand Detail Panel" />
                                        </tooltip>
                                    </Button>
                                    <Label text="Log Detail (Collapsed)">
                                        <font>
                                            <Font name="System Bold" size="10.0" />
                                        </font>
                                    </Label>
                                </HBox>
                            </bottom>

                            <center>
                                <SplitPane fx:id="verticalSplitPane" dividerPositions="0.7" orientation="VERTICAL">
                                    <!-- Center Panel: Log Table -->
                                    <VBox spacing="5">
                                        <padding>
                                            <Insets bottom="5" left="5" right="5" top="5" />
                                        </padding>

                                        <StackPane fx:id="logContainer" VBox.vgrow="ALWAYS" />
                                    </VBox>

                                    <!-- Bottom Panel: Log Detail -->
                                    <VBox fx:id="bottomPanel" minHeight="150" prefHeight="200" spacing="5">
                                        <padding>
                                            <Insets bottom="5" left="5" right="5" top="5" />
                                        </padding>

                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <Label fx:id="detailLabel" text="Log Detail" HBox.hgrow="ALWAYS">
                                                <font>
                                                    <Font name="System Bold" size="12.0" />
                                                </font>
                                            </Label>

                                            <HBox alignment="CENTER_LEFT" spacing="5">
                                                <ToggleButton fx:id="prettifyJsonButton" prefHeight="10.0" prefWidth="10.0">
                                                    <graphic>
                                                        <FontAwesomeIconView glyphName="INDENT" size="12" />
                                                    </graphic>
                                                    <tooltip>
                                                        <Tooltip text="Auto-Prettify JSON" />
                                                    </tooltip>
                                                </ToggleButton>
                                                <ToggleButton fx:id="prettifyXmlButton" prefHeight="10.0" prefWidth="10.0">
                                                    <graphic>
                                                        <FontAwesomeIconView glyphName="CODE" size="12" />
                                                    </graphic>
                                                    <tooltip>
                                                        <Tooltip text="Auto-Prettify XML" />
                                                    </tooltip>
                                                </ToggleButton>
                                                <Button fx:id="copyButton">
                                                    <graphic>
                                                        <FontAwesomeIconView glyphName="COPY" size="12" />
                                                    </graphic>
                                                    <tooltip>
                                                        <Tooltip text="Copy" />
                                                    </tooltip>
                                                </Button>
                                                <Button fx:id="clearDetailButton">
                                                    <graphic>
                                                        <FontAwesomeIconView glyphName="CLOSE" size="12" />
                                                    </graphic>
                                                    <tooltip>
                                                        <Tooltip text="Clear" />
                                                    </tooltip>
                                                </Button>
                                                <Separator orientation="VERTICAL" />
                                                <Button fx:id="pinBottomPanelButton">
                                                    <graphic>
                                                        <FontAwesomeIconView glyphName="ANGLE_DOUBLE_DOWN" size="12" />
                                                    </graphic>
                                                    <tooltip>
                                                        <Tooltip text="Pin/Unpin Detail Panel" />
                                                    </tooltip>
                                                </Button>
                                            </HBox>
                                        </HBox>
                                        
                                        <StackPane fx:id="detailContainer" VBox.vgrow="ALWAYS" style="-fx-border-color: #cccccc; -fx-border-width: 1;">
                                             <padding>
                                                 <Insets bottom="0" left="0" right="0" top="0"/>
                                             </padding>
                                        </StackPane>
                                    </VBox>
                                </SplitPane>
                            </center>
                        </BorderPane>
                    </SplitPane>
                </center>
            </BorderPane>

            <!-- Loading Overlay -->
            <VBox fx:id="loadingOverlay" alignment="CENTER" visible="false" mouseTransparent="false" pickOnBounds="true" style="-fx-background-color: rgba(0, 0, 0, 0.4);">
                <VBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 0); -fx-min-width: 300; -fx-max-width: 400;">
                    <ProgressIndicator fx:id="loadingProgress" minWidth="60" minHeight="60" maxWidth="60" maxHeight="60" />
                    <Label text="Processing Request..." textFill="#333333">
                        <font>
                            <Font name="System Bold" size="18.0" />
                        </font>
                    </Label>
                    <Label fx:id="loadingLabel" text="Please wait..." textFill="#666666" wrapText="true" textAlignment="CENTER">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                    <Button text="Cancel" onAction="#handleCancelProcessing" style="-fx-base: #ffdddd; -fx-text-fill: #cc0000; -fx-border-color: #cc0000; -fx-border-radius: 3; -fx-background-radius: 3;">
                        <tooltip>
                            <Tooltip text="Stop current operation" />
                        </tooltip>
                    </Button>
                </VBox>
            </VBox>

            <!-- NOTE: clip Rectangle size is set/bound in controller (FXML binding to width/height isn't reliable here). -->
            <clip>
                <Rectangle fx:id="centerClip" />
            </clip>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 3 10 3 10; -fx-background-color: #f0f0f0; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;">
            <!-- Status Info (left side) -->
            <Label fx:id="statusLabel" text="Line: 0 / 0 (0%)" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-text-fill: #333333;"/>
            <Separator orientation="VERTICAL" />
            
            <!-- Spacer to push memory stats to right -->
            <Region HBox.hgrow="ALWAYS" />
            
            <!-- Memory Stats (right side) -->
             <Button text="GC" onAction="#handleGC" style="-fx-font-size: 10px; -fx-padding: 2 5;">
                <tooltip><Tooltip text="Minta Garbage Collection (System.gc())" /></tooltip>
             </Button>
            <Separator orientation="VERTICAL" />
            <Label fx:id="memoryStatusLabel" text="Memory: ..." style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-text-fill: #555555;"/>
            <ProgressBar fx:id="memoryBar" prefWidth="100" progress="0.0" style="-fx-accent: #2196f3; -fx-control-inner-background: #e0e0e0;" >
                <tooltip><Tooltip text="Heap Usage" /></tooltip>
            </ProgressBar>
        </HBox>
    </bottom>

</BorderPane>
