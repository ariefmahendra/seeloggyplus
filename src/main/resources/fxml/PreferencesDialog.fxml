<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="settingsRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="preferences-dialog, simple-dialog" prefWidth="660" prefHeight="460" fx:controller="com.seeloggyplus.app.PreferencesDialogController">
    <left>
        <VBox prefWidth="148" minWidth="148" maxWidth="148" spacing="8" styleClass="settings-sidebar">
            <Label text="Settings" styleClass="settings-sidebar-title"/>
            <ListView fx:id="settingsCategories" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>
    <center>
        <StackPane>
            <ScrollPane fx:id="generalPage" fitToWidth="true" hbarPolicy="NEVER" styleClass="settings-scroll">
                <content>
                    <VBox spacing="12" styleClass="settings-page">
                        <VBox spacing="2">
                            <Label text="General" styleClass="settings-page-title" wrapText="true" maxWidth="Infinity"/>
                            <Label text="Appearance and everyday application behavior." styleClass="settings-description" wrapText="true" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="10" styleClass="settings-section">
                            <Label text="Appearance" styleClass="settings-section-title" wrapText="true" maxWidth="Infinity"/>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS">
                                    <Label text="Theme" styleClass="settings-row-title" wrapText="true" maxWidth="Infinity"/>
                                    <Label text="Choose the appearance of the application." styleClass="settings-description" wrapText="true" maxWidth="Infinity"/>
                                </VBox>
                                <ComboBox fx:id="themeComboBox" prefWidth="180" minWidth="180" maxWidth="180"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="10" styleClass="settings-section">
                            <Label text="File Management" styleClass="settings-section-title" wrapText="true" maxWidth="Infinity"/>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS">
                                    <Label text="File double-click" styleClass="settings-row-title" wrapText="true" maxWidth="Infinity"/>
                                    <Label text="Choose what double-click or Enter does to files. Folders always open." styleClass="settings-description" wrapText="true" maxWidth="Infinity"/>
                                </VBox>
                                <ComboBox fx:id="fileDoubleClickComboBox" prefWidth="180" minWidth="180" maxWidth="180"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="10" styleClass="settings-section">
                            <Label text="Performance" styleClass="settings-section-title" wrapText="true" maxWidth="Infinity"/>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS">
                                    <Label text="Memory limit" styleClass="settings-row-title" wrapText="true" maxWidth="Infinity"/>
                                    <Label text="1–16 GB. Requires restart to take effect." styleClass="settings-description" wrapText="true" maxWidth="Infinity"/>
                                </VBox>
                                <Spinner fx:id="appMaxMemorySpinner" editable="true" prefWidth="104" minWidth="104" maxWidth="104"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
            <ScrollPane fx:id="logViewerPage" fitToWidth="true" hbarPolicy="NEVER" styleClass="settings-scroll">
                <content>
                    <VBox spacing="12" styleClass="settings-page">
                        <VBox spacing="2">
                            <Label text="Log Viewer" styleClass="settings-page-title" wrapText="true" maxWidth="Infinity"/>
                            <Label text="Text, preview limits, and formatting for log content." styleClass="settings-description" wrapText="true" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="10" styleClass="settings-section">
                            <Label text="Text" styleClass="settings-section-title" wrapText="true" maxWidth="Infinity"/>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS">
                                    <Label text="Font family" styleClass="settings-row-title" wrapText="true" maxWidth="Infinity"/>
                                    <Label text="Used for log details and file previews." styleClass="settings-description" wrapText="true" maxWidth="Infinity"/>
                                </VBox>
                                <ComboBox fx:id="appFontFamilyComboBox" prefWidth="180" minWidth="180" maxWidth="180"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS">
                                    <Label text="Font size" styleClass="settings-row-title" wrapText="true" maxWidth="Infinity"/>
                                    <Label text="8–30 px." styleClass="settings-description" wrapText="true" maxWidth="Infinity"/>
                                </VBox>
                                <Spinner fx:id="appFontSizeSpinner" editable="true" prefWidth="104" minWidth="104" maxWidth="104"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="10" styleClass="settings-section">
                            <Label text="Buffer &amp; Preview" styleClass="settings-section-title" wrapText="true" maxWidth="Infinity"/>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS">
                                    <Label text="Tail window" styleClass="settings-row-title" wrapText="true" maxWidth="Infinity"/>
                                    <Label text="Keep 1,000–100,000 rows while tailing." styleClass="settings-description" wrapText="true" maxWidth="Infinity"/>
                                </VBox>
                                <Spinner fx:id="tailWindowSizeSpinner" editable="true" prefWidth="104" minWidth="104" maxWidth="104"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS">
                                    <Label text="Preview line limit" styleClass="settings-row-title" wrapText="true" maxWidth="Infinity"/>
                                    <Label text="Show 1–10,000 lines in previews." styleClass="settings-description" wrapText="true" maxWidth="Infinity"/>
                                </VBox>
                                <Spinner fx:id="lpLineLimitSpinner" editable="true" prefWidth="104" minWidth="104" maxWidth="104"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="10" styleClass="settings-section">
                            <Label text="Formatting" styleClass="settings-section-title" wrapText="true" maxWidth="Infinity"/>
                            <VBox spacing="8">
                                <CheckBox fx:id="mainAutoPrettifyJsonCheckBox" text="Automatically format JSON"/>
                                <CheckBox fx:id="mainAutoPrettifyXmlCheckBox" text="Automatically format XML"/>
                            </VBox>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
            <ScrollPane fx:id="sshPage" fitToWidth="true" hbarPolicy="NEVER" styleClass="settings-scroll">
                <content>
                    <VBox spacing="12" styleClass="settings-page">
                        <VBox spacing="2">
                            <Label text="SSH" styleClass="settings-page-title" wrapText="true" maxWidth="Infinity"/>
                            <Label text="Connection defaults and downloaded file management." styleClass="settings-description" wrapText="true" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="10" styleClass="settings-section">
                            <Label text="Connection" styleClass="settings-section-title" wrapText="true" maxWidth="Infinity"/>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS">
                                    <Label text="Connection timeout" styleClass="settings-row-title" wrapText="true" maxWidth="Infinity"/>
                                    <Label text="1–600 seconds before a connection times out." styleClass="settings-description" wrapText="true" maxWidth="Infinity"/>
                                </VBox>
                                <Spinner fx:id="sshTimeoutSpinner" editable="true" prefWidth="104" minWidth="104" maxWidth="104"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="10" styleClass="settings-section">
                            <Label text="Downloads" styleClass="settings-section-title" wrapText="true" maxWidth="Infinity"/>
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS">
                                    <Label text="Download threads" styleClass="settings-row-title" wrapText="true" maxWidth="Infinity"/>
                                    <Label text="Concurrent download workers, up to the available CPU count." styleClass="settings-description" wrapText="true" maxWidth="Infinity"/>
                                </VBox>
                                <Spinner fx:id="sshThreadsSpinner" editable="true" prefWidth="104" minWidth="104" maxWidth="104"/>
                            </HBox>
                            <VBox spacing="6">
                                <Label text="Download directory" styleClass="settings-row-title" wrapText="true" maxWidth="Infinity"/>
                                <Label text="Leave empty to use the system temporary directory." styleClass="settings-description" wrapText="true" maxWidth="Infinity"/>
                                <HBox spacing="6">
                                    <TextField fx:id="sshDownloadDirField" promptText="System temporary directory" minWidth="0" HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="sshDownloadDirBrowseButton" text="Browse"/>
                                </HBox>
                                <HBox spacing="6">
                                    <Button fx:id="sshOpenDownloadDirButton" text="Open Folder"/>
                                    <Button fx:id="sshCleanDownloadsButton" text="Clean Downloads"/>
                                </HBox>
                                <Label fx:id="sshDownloadInfoLabel" styleClass="settings-description" wrapText="true" maxWidth="Infinity"/>
                            </VBox>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </StackPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="8" styleClass="settings-footer">
            <Button fx:id="cancelButton" text="Cancel" cancelButton="true"/>
            <Button fx:id="saveButton" text="Save" defaultButton="true"/>
        </HBox>
    </bottom>
</BorderPane>
