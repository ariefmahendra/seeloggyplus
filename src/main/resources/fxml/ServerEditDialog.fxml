<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.seeloggyplus.features.servers.presentation.ServerEditDialogController"
      prefWidth="440" prefHeight="420" spacing="0" styleClass="server-edit-dialog, simple-dialog">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="dialog-form-scroll">
        <VBox spacing="10" styleClass="server-edit-body">

            <VBox spacing="3">
                <Label text="Server Name" styleClass="server-edit-label"/>
                <TextField fx:id="nameField" promptText="e.g., Production Server"/>
                <Label fx:id="nameErrorLabel" styleClass="server-edit-error" managed="false" visible="false"/>
            </VBox>

            <HBox spacing="10">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <HBox spacing="3">
                        <Label text="Host" styleClass="server-edit-label"/>
                        <Label text="*" styleClass="text-secondary"/>
                    </HBox>
                    <TextField fx:id="hostField" promptText="e.g., 192.168.1.100 or server.com"/>
                    <Label fx:id="hostErrorLabel" styleClass="server-edit-error" managed="false" visible="false"/>
                </VBox>

                <VBox spacing="3" prefWidth="96" minWidth="96" maxWidth="96">
                    <HBox spacing="3">
                        <Label text="Port" styleClass="server-edit-label"/>
                        <Label text="*" styleClass="text-secondary"/>
                    </HBox>
                    <TextField fx:id="portField" text="22" promptText="22"/>
                    <Label fx:id="portErrorLabel" styleClass="server-edit-error" managed="false" visible="false"/>
                </VBox>
            </HBox>

            <HBox spacing="10">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <HBox spacing="3">
                        <Label text="Username" styleClass="server-edit-label"/>
                        <Label text="*" styleClass="text-secondary"/>
                    </HBox>
                    <TextField fx:id="usernameField" promptText="SSH username"/>
                    <Label fx:id="usernameErrorLabel" styleClass="server-edit-error" managed="false" visible="false"/>
                </VBox>

                <VBox spacing="3" prefWidth="148" minWidth="148" maxWidth="148">
                    <Label text="Authentication" styleClass="server-edit-label"/>
                    <ChoiceBox fx:id="authTypeChoice" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <VBox fx:id="passwordAuthBox" spacing="6">
                <Label text="Password" styleClass="server-edit-label"/>
                <HBox spacing="6" alignment="CENTER_LEFT" fillHeight="false">
                    <PasswordField fx:id="passwordField" promptText="SSH password" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="showPasswordButton" styleClass="server-edit-icon-button">
                        <graphic>
                            <FontAwesomeIconView glyphName="EYE" size="12"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Show/Hide Password"/>
                        </tooltip>
                    </Button>
                </HBox>
                <CheckBox fx:id="savePasswordCheckBox" text="Save password (stored encrypted)"/>
            </VBox>

            <VBox fx:id="keyAuthBox" spacing="6" managed="false" visible="false">
                <Label text="Private Key File" styleClass="server-edit-label"/>
                <HBox spacing="6" alignment="CENTER_LEFT" fillHeight="false">
                    <TextField fx:id="keyPathField" promptText="e.g., C:\Users\me\.ssh\id_ed25519" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="browseKeyButton" text="Browse..." styleClass="browse-button"/>
                </HBox>
                <Label text="Passphrase (leave empty for an unencrypted key)" styleClass="server-edit-label"/>
                <PasswordField fx:id="keyPassphraseField" promptText="Optional passphrase"/>
                <CheckBox fx:id="savePassphraseCheckBox" text="Save passphrase (stored encrypted)"/>
            </VBox>

            <VBox spacing="3">
                <Label text="Default Path" styleClass="server-edit-label"/>
                <TextField fx:id="defaultPathField" text="/" promptText="/var/log"/>
                <Label text="Starting directory when browsing files" styleClass="settings-description"/>
            </VBox>
        </VBox>
    </ScrollPane>

    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="server-edit-footer">
        <Button text="Test Connection" fx:id="testButton"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel" fx:id="cancelButton" cancelButton="true"/>
        <Button text="Save" fx:id="saveButton" defaultButton="true"/>
    </HBox>
</VBox>
