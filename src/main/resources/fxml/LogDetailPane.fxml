<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="bottomPanel" minHeight="80" prefHeight="180" spacing="5" styleClass="embedded-panel" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.seeloggyplus.features.detail.presentation.LogDetailPaneController">
    <padding>
        <Insets bottom="5" left="5" right="5" top="5"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="detailLabel" text="Log Detail" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="panel-title"/>

        <FlowPane styleClass="compact-actions,detail-actions" minWidth="0" prefWrapLength="400" hgap="4" vgap="4" HBox.hgrow="ALWAYS">
            <ToggleButton fx:id="rawModeButton" text="Raw" selected="true" accessibleText="Show original log content"/>
            <ToggleButton fx:id="formattedModeButton" text="Formatted" disable="true" accessibleText="Show formatted log content"/>
            <Button fx:id="copyButton">
                <graphic>
                    <FontAwesomeIconView glyphName="COPY" size="12"/>
                </graphic>
                <tooltip>
                    <Tooltip text="Copy"/>
                </tooltip>
            </Button>
            <Button fx:id="clearDetailButton">
                <graphic>
                    <FontAwesomeIconView glyphName="ERASER" size="12"/>
                </graphic>
                <tooltip>
                    <Tooltip text="Clear Detail Content"/>
                </tooltip>
            </Button>
            <Separator orientation="VERTICAL"/>
            <Button fx:id="pinBottomPanelButton">
                <graphic>
                    <FontAwesomeIconView glyphName="TIMES" size="12"/>
                </graphic>
                <tooltip>
                    <Tooltip text="Close Detail Panel (Ctrl+J)"/>
                </tooltip>
            </Button>
        </FlowPane>
    </HBox>

    <StackPane fx:id="detailContainer" VBox.vgrow="ALWAYS" styleClass="detail-container">
        <padding>
            <Insets/>
        </padding>
    </StackPane>
</VBox>
