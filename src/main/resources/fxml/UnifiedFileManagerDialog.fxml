<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.seeloggyplus.controller.UnifiedFileManagerDialogController"
            prefWidth="900" prefHeight="600" styleClass="unified-file-manager-dialog">
    
    <!-- Top: Navigation & Search -->
    <top>
        <VBox>
            <ToolBar styleClass="app-toolbar">
                <Button fx:id="backButton" disable="true">
                    <graphic>
                        <FontAwesomeIconView glyphName="ARROW_LEFT" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Back"/>
                    </tooltip>
                </Button>
                
                <Button fx:id="forwardButton" disable="true">
                    <graphic>
                        <FontAwesomeIconView glyphName="ARROW_RIGHT" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Forward"/>
                    </tooltip>
                </Button>
                
                <Button fx:id="upButton" disable="true">
                    <graphic>
                        <FontAwesomeIconView glyphName="ARROW_UP" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Up to parent directory"/>
                    </tooltip>
                </Button>
                
                <Separator orientation="VERTICAL"/>
                
                <Button fx:id="homeButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="HOME" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Home directory"/>
                    </tooltip>
                </Button>
                
                <Button fx:id="refreshButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="REFRESH" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Refresh"/>
                    </tooltip>
                </Button>
                
                <Separator orientation="VERTICAL"/>
                
                <Label text="Path:"/>
                <TextField fx:id="pathField" HBox.hgrow="ALWAYS" promptText="/"/>
                <Button fx:id="goButton" text="Go"/>
                
                <Separator orientation="VERTICAL"/>
                
                <TextField fx:id="searchField" promptText="Search files..." prefWidth="200"/>

                <Separator orientation="VERTICAL"/>

                <Button fx:id="findInFilesButton" text="Find in Files" disable="true">
                    <graphic>
                        <FontAwesomeIconView glyphName="SEARCH"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Search text inside all remote files under the current folder"/>
                    </tooltip>
                </Button>
            </ToolBar>
        </VBox>
    </top>
    
    <!-- Center: Split Pane (Locations | Files) -->
    <center>
        <SplitPane dividerPositions="0.25">
            <!-- Left: Locations -->
            <VBox fx:id="locationsContainer" styleClass="locations-container" spacing="5">
                <padding>
                    <Insets top="10" right="5" bottom="10" left="10"/>
                </padding>
                <Label text="Locations" styleClass="section-title"/>
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Button fx:id="newGroupButton">
                        <graphic>
                            <FontAwesomeIconView glyphName="FOLDER_OPEN" size="12"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="New group (inside the selected group)"/>
                        </tooltip>
                    </Button>
                    <Button fx:id="favoriteCurrentButton">
                        <graphic>
                            <FontAwesomeIconView glyphName="STAR" size="12"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Favorite this folder"/>
                        </tooltip>
                    </Button>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="manageServersButton">
                        <graphic>
                            <FontAwesomeIconView glyphName="COG" size="12"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Manage Servers"/>
                        </tooltip>
                    </Button>
                </HBox>
                <StackPane VBox.vgrow="ALWAYS">
                    <TreeView fx:id="locationTree" showRoot="false"/>
                    <Label fx:id="locationDropHint" styleClass="location-drop-hint" visible="false"
                           mouseTransparent="true" wrapText="true" maxWidth="Infinity" StackPane.alignment="BOTTOM_CENTER"/>
                </StackPane>
                <TitledPane fx:id="favoritesPane" text="Favorite folders" expanded="false" maxHeight="220">
                    <content>
                        <VBox fx:id="favoritesBox" spacing="4"/>
                    </content>
                </TitledPane>
            </VBox>
            
            <!-- Right: File Browser -->
            <VBox>
                <TableView fx:id="fileTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="iconColumn" text="" prefWidth="40" minWidth="40" maxWidth="40" sortable="false"/>
                        <TableColumn fx:id="nameColumn" text="NAME" prefWidth="350" minWidth="150"/>
                        <TableColumn fx:id="sizeColumn" text="SIZE" prefWidth="100" minWidth="80"/>
                        <TableColumn fx:id="typeColumn" text="TYPE" prefWidth="100" minWidth="80"/>
                        <TableColumn fx:id="modifiedColumn" text="MODIFIED" prefWidth="150" minWidth="120"/>
                        <TableColumn fx:id="permissionsColumn" text="PERMISSIONS" prefWidth="100" minWidth="90"/>
                        <TableColumn fx:id="ownerColumn" text="OWNER" prefWidth="100" minWidth="80"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10">
                            <FontAwesomeIconView glyphName="FOLDER_OPEN" size="48" styleClass="empty-state-icon"/>
                            <Label text="No files found" styleClass="empty-state-subtitle"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>
        </SplitPane>
    </center>
    
    <!-- Bottom: Status & Actions -->
    <bottom>
        <VBox>
            <Separator/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="5" right="10" bottom="5" left="10"/>
                </padding>
                <Label fx:id="statusLabel" text="Ready"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="itemCountLabel" text="0 items"/>
                <Separator orientation="VERTICAL"/>
                <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="20" prefHeight="20"/>
            </HBox>
            
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
                <Button text="Cancel" fx:id="cancelButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="TIMES" size="12"/>
                    </graphic>
                </Button>
                <Button text="Preview" fx:id="previewButton" disable="true">
                    <graphic>
                        <FontAwesomeIconView glyphName="EYE" size="12"/>
                    </graphic>
                </Button>
                <Button text="Tail" fx:id="tailButton" disable="true" onAction="#handleTail">
                    <graphic>
                        <FontAwesomeIconView glyphName="TERMINAL" size="12"/>
                    </graphic>
                </Button>
                <Button text="Open" fx:id="openButton" defaultButton="true" disable="true">
                    <graphic>
                        <FontAwesomeIconView glyphName="CHECK" size="12"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </bottom>
    
</BorderPane>
