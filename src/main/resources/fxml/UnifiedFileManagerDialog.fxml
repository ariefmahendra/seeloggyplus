<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.seeloggyplus.features.files.presentation.UnifiedFileManagerDialogController" prefWidth="1000" prefHeight="640" styleClass="unified-file-manager-dialog, simple-dialog">
    <top>
        <VBox>
            <HBox fx:id="pathToolbar" styleClass="file-manager-path-toolbar" spacing="6" alignment="CENTER_LEFT">
                <Button fx:id="backButton" disable="true" styleClass="file-manager-icon-button" accessibleText="Back">
                    <graphic>
                        <FontAwesomeIconView glyphName="ARROW_LEFT" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Back"/>
                    </tooltip>
                </Button>
                <Button fx:id="forwardButton" disable="true" styleClass="file-manager-icon-button" accessibleText="Forward">
                    <graphic>
                        <FontAwesomeIconView glyphName="ARROW_RIGHT" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Forward"/>
                    </tooltip>
                </Button>
                <Button fx:id="upButton" disable="true" styleClass="file-manager-icon-button" accessibleText="Parent folder">
                    <graphic>
                        <FontAwesomeIconView glyphName="ARROW_UP" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Up to parent directory"/>
                    </tooltip>
                </Button>
                <Button fx:id="homeButton" styleClass="file-manager-icon-button" accessibleText="Home folder">
                    <graphic>
                        <FontAwesomeIconView glyphName="HOME" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Home directory"/>
                    </tooltip>
                </Button>
                <Button fx:id="refreshButton" styleClass="file-manager-icon-button" accessibleText="Refresh">
                    <graphic>
                        <FontAwesomeIconView glyphName="REFRESH" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Refresh"/>
                    </tooltip>
                </Button>
                <Separator orientation="VERTICAL"/>
                <TextField fx:id="pathField" HBox.hgrow="ALWAYS" promptText="/"/>
                <Separator orientation="VERTICAL"/>
                <TextField fx:id="searchField" promptText="Filter files..." prefWidth="180" minWidth="140" maxWidth="180" accessibleText="Filter files by name"/>
                <Button fx:id="findInFilesButton" disable="true" accessibleText="Find text in files" styleClass="file-manager-icon-button">
                    <graphic>
                        <FontAwesomeIconView glyphName="SEARCH" size="12"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Search text inside all remote files under the current folder"/>
                    </tooltip>
                </Button>
            </HBox>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.2" fx:id="fileSplit">
            <VBox fx:id="locationsContainer" styleClass="locations-container" spacing="8" prefWidth="200" minWidth="160" maxWidth="320">
                <padding>
                    <Insets top="12" right="10" bottom="10" left="10"/>
                </padding>
                <HBox spacing="4" alignment="CENTER_LEFT" styleClass="file-manager-location-header">
                    <Label text="Locations" styleClass="section-title" minWidth="0"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="newGroupButton" styleClass="file-manager-icon-button">
                        <graphic>
                            <FontAwesomeIconView glyphName="FOLDER_OPEN" size="12"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="New group (inside the selected group)"/>
                        </tooltip>
                    </Button>
                    <Button fx:id="favoriteCurrentButton" styleClass="file-manager-icon-button">
                        <graphic>
                            <FontAwesomeIconView glyphName="STAR" size="12"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Favorite this folder"/>
                        </tooltip>
                    </Button>
                    <Button fx:id="manageServersButton" styleClass="file-manager-icon-button">
                        <graphic>
                            <FontAwesomeIconView glyphName="COG" size="12"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Manage Servers"/>
                        </tooltip>
                    </Button>
                </HBox>
                <HBox fx:id="lastServerBox" spacing="4" visible="false" managed="false" alignment="CENTER_LEFT">
                    <Label fx:id="lastServerLabel" wrapText="false" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="connectLastServerButton" text="Connect" minHeight="28" prefHeight="28" maxHeight="28" maxWidth="64" minWidth="64"/>
                </HBox>
                <StackPane VBox.vgrow="ALWAYS">
                    <TreeView fx:id="locationTree" showRoot="false"/>
                    <Label fx:id="locationDropHint" styleClass="location-drop-hint" visible="false" mouseTransparent="true" wrapText="true" maxWidth="Infinity" StackPane.alignment="BOTTOM_CENTER"/>
                </StackPane>
                <TitledPane fx:id="favoritesPane" text="Favorite folders" expanded="false" maxHeight="220">
                    <VBox fx:id="favoritesBox" spacing="4"/>
                </TitledPane>
            </VBox>
            <VBox>
                <TableView fx:id="fileTable" VBox.vgrow="ALWAYS" fixedCellSize="28" tableMenuButtonVisible="true">
                    <columns>
                        <TableColumn fx:id="nameColumn" text="NAME" prefWidth="350" minWidth="180"/>
                        <TableColumn fx:id="sizeColumn" text="SIZE" prefWidth="88" minWidth="72"/>
                        <TableColumn fx:id="typeColumn" text="TYPE" prefWidth="90" minWidth="70" visible="false"/>
                        <TableColumn fx:id="modifiedColumn" text="MODIFIED" prefWidth="145" minWidth="130"/>
                        <TableColumn fx:id="permissionsColumn" text="PERMISSIONS" prefWidth="110" minWidth="90" visible="false"/>
                        <TableColumn fx:id="ownerColumn" text="OWNER" prefWidth="100" minWidth="80" visible="false"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10">
                            <FontAwesomeIconView glyphName="FOLDER_OPEN" size="48" styleClass="empty-state-icon"/>
                            <Label text="No files found" styleClass="empty-state-subtitle"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>
        </SplitPane>
    </center>
    <bottom>
        <HBox styleClass="file-manager-footer" spacing="8" alignment="CENTER_LEFT" fx:id="fileManagerFooter">
            <Label fx:id="statusLabel" text="Ready" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Label fx:id="itemCountLabel" text="0 items" maxWidth="110"/>
            <ProgressIndicator fx:id="progressIndicator" styleClass="file-manager-progress" visible="false" managed="false" minWidth="16" prefWidth="16" maxWidth="16" minHeight="16" prefHeight="16" maxHeight="16"/>
            <Button text="Cancel" fx:id="cancelButton" cancelButton="true">
                <graphic>
                    <FontAwesomeIconView glyphName="TIMES" size="12"/>
                </graphic>
            </Button>
            <Button text="Preview" fx:id="previewButton" disable="true">
                <graphic>
                    <FontAwesomeIconView glyphName="EYE" size="12"/>
                </graphic>
            </Button>
            <Button text="Tail" fx:id="tailButton" disable="true" onAction="#handleTail">
                <graphic>
                    <FontAwesomeIconView glyphName="TERMINAL" size="12"/>
                </graphic>
            </Button>
            <Button text="Open" fx:id="openButton" defaultButton="true" disable="true">
                <graphic>
                    <FontAwesomeIconView glyphName="CHECK" size="12"/>
                </graphic>
            </Button>
        </HBox>
    </bottom>
</BorderPane>
